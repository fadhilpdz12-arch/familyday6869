# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# Kunci service role. JANGAN sesekali beri awalan NEXT_PUBLIC_.
# Hanya digunakan di dalam Server Action / Route Handler.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# --- Panel AJK ---
# Kata laluan biasa — bagi pada semua AJK.
KATA_LALUAN_AJK="tukar-kata-laluan-ini"
# Kata laluan Pengerusi — jangan kongsi. Yang ni boleh assign tugas & urus pasukan.
KATA_LALUAN_PENGERUSI="kata-laluan-huda-sahaja"
# Rahsia untuk menandatangani kuki sesi. Jana: openssl rand -base64 48
RAHSIA_SESI="jana-rahsia-panjang-di-sini"
